# =============================================================================
# ERP Maquila - variables de entorno
# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# =============================================================================

# Cadena de conexión de Postgres de Supabase.
# Panel de Supabase > botón "Connect" > "Session pooler" (puerto 5432).
# Sustituya [YOUR-PASSWORD] por la contraseña de la base de datos.
# Si se deja vacía en desarrollo, el servidor usa una base de datos en memoria (sandbox).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opcional: certificado CA de Supabase (Project Settings > Database > SSL Configuration)
# para verificar el certificado TLS. Pegue el contenido en una sola línea usando \n.
# DATABASE_CA_CERT=
# Opcional: "disable" para conexiones sin TLS (solo Postgres local).
# DATABASE_SSL=
# Opcional: máximo de conexiones simultáneas del pool (por defecto 10).
# DATABASE_POOL_MAX=10

# Secreto para firmar los tokens de sesión (obligatorio en producción, mínimo 32 caracteres).
# Genere uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Primer administrador: se crea al arrancar si la base no tiene ningún admin activo.
# Después de iniciar sesión por primera vez puede quitar ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Puerto HTTP (por defecto 3000) y modo de ejecución.
PORT=3000
# NODE_ENV=production
